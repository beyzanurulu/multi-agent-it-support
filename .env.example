# --- LLM (optional; without them rule-based fallbacks are used) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b

# --- LangSmith ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-it-support

# --- Security / limits ---
AUTH_SECRET=change-me
CHAINLIT_AUTH_SECRET=change-me-to-a-long-random-string
DEMO_ACCOUNTS=calisan:demo,uzman:demo,yonetici:demo
READONLY_DB_PASSWORD=readonly
MAX_STEPS=8
DAILY_MESSAGE_LIMIT=50
DAILY_TOKEN_BUDGET=2000000

# --- Local dev outside docker ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpdesk
READONLY_DATABASE_URL=postgresql://helpdesk_readonly:readonly@localhost:5432/helpdesk
EMBEDDING_PROVIDER=fastembed
NLU_URL=http://localhost:8002
MCP_URL=http://localhost:8001/mcp
