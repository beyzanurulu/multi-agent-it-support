    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(nlu_inference_seconds_bucket[5m])))",
     "legendFormat": "{{backend}}"
