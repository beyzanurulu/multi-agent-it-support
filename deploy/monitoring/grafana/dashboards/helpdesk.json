{
 "uid": "it-helpdesk",
 "title": "Türkçe IT Destek — Agentlar",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "İstek / dk (rol)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (role) (rate(agent_requests_total[5m])) * 60",
     "legendFormat": "{{role}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Ajan başına p95 latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(agent_step_seconds_bucket[5m])))",
     "legendFormat": "{{agent}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "İlk yanıt p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_first_response_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Token tüketimi / saat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent) (increase(agent_llm_tokens_total[1h]))",
     "legendFormat": "{{agent}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "barchart",
   "title": "Guardrail tetiklenmeleri",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (increase(agent_guardrail_triggers_total[1h]))",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Tool çağrıları",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tool, status) (rate(agent_tool_calls_total[5m])) * 60",
     "legendFormat": "{{tool}} {{status}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "NLU inference p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
